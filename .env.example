# Vitality AI Coach for Garmin — configuration
# Copy to `.env` and fill in the values you need. The app runs with the bare
# minimum: an APP_SECRET_KEY (auto-generated if missing) and ONE LLM provider.
# Everything else is optional.

# ── App ───────────────────────────────────────────────────────────────────────
# Used to encrypt user data (Garmin credentials, chat messages).
# Leave empty to auto-generate on first boot (persisted to ./data/.secret).
# In hosted/multi-instance setups set it explicitly and NEVER change it.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_SECRET_KEY=

# Comma-separated list of allowed browser origins (CORS).
# Self-host: keep localhost. Hosted: add your public site.
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000,http://localhost:8000

LOG_LEVEL=INFO
PORT=8000

# ── LLM provider — pick ONE ───────────────────────────────────────────────────
# Options: ollama | groq | openrouter | openai | openai_compatible | mistral | auto
# `auto` picks the first configured one (openrouter → mistral → groq → openai).
LLM_PROVIDER=groq

# Ollama (local, free, private). Pull a model first: `ollama pull llama3.2`.
# For docker compose with the ollama profile use OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434

# Groq (cloud, free tier, no credit card) — great default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (cloud, many models incl. free ones).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,meta-llama/llama-3.3-70b-instruct:free

# OpenAI (cloud, paid).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Any OpenAI-compatible endpoint (LM Studio, vLLM, Together, DeepSeek, Fireworks…).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Mistral (cloud).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Database ───────────────────────────────────────────────────────────────────
# Default: local SQLite file in ./data (zero config, good for one user).
# For multi-user hosting use Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/vitality
DATABASE_URL=sqlite:///./data/garmin_coach.db

# ── Optional services (skip if you don't need them) ───────────────────────────
# Push notifications (Firebase Admin SDK). Either a path or inline JSON.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Text-to-speech (Google Cloud). Inline service-account JSON.
GOOGLE_CREDENTIALS_JSON=

# Social login (Supabase REST keys). Required only for Google OAuth / magic link
# on the web client; email/password auth works without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Background sync ────────────────────────────────────────────────────────────
# Built-in scheduler (APScheduler) for single-instance self-hosting.
# Set to false if you use an external cron instead (see /api/v1/internal/sync-all-active).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=2

# Shared secret for /internal/* endpoints (used by external cron). Generate one:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CLOUD_TASKS_SECRET=

# Public URL of this instance (used for watch pairing / external cron).
BACKEND_URL=

# ── Frontend build (web) ──────────────────────────────────────────────────────
# Only used when building the frontend. For self-host served at the root keep "/".
# VITE_BASE=/
# VITE_API_URL=http://localhost:8000/api/v1

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
# These go in mobile/.env
# EXPO_PUBLIC_API_URL=http://localhost:8000
